{
  // Phần mềm quản lý nhân sự VIETCASA (AGPL-3.0)
  // Cloudflare Worker + cơ sở dữ liệu D1 trên tài khoản của chính đơn vị.
  // database_id: nút Deploy to Cloudflare hoặc lệnh cai-dat.cmd tự tạo cơ sở dữ liệu và điền vào.
  "name": "quan-ly-nhan-suu",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "quan-ly-nhan-su-db", "database_id": "85d0cb81-b056-4c26-bc3e-f1aac52e3422" }
  ],
  // Gửi báo cáo định kỳ: máy chủ tự kiểm tra 15 phút/lần, đến giờ thì gửi
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
